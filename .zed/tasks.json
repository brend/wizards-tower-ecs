[
  {
    "label": "Debug game in Firefox",
    "command": "npm",
    "args": ["run", "dev", "--", "--open"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "BROWSER": "firefox",
      "BROWSER_ARGS": "--devtools"
    }
  },
  {
    "label": "Start Vite for Edge debugging",
    "command": "npm",
    "args": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
